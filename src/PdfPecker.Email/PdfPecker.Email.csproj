<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>PdfPecker.Email</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>PdfPecker.Email</PackageId>
    <Authors>Moonwalker1307</Authors>
    <Description>Convert e-mail (.eml, MIME) to PDF and PDF/A-3 with PdfPecker: headers, HTML or plain text bodies, inline images and the attachments embedded in the PDF. Dependency-free apart from PdfPecker; HTML bodies are sanitised and nothing is fetched from the network.</Description>
    <PackageTags>email;eml;mime;rfc822;pdf;pdfa;pdf-a-3;email-to-pdf;eml-to-pdf;archive;attachments;pdfpecker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Moonwalker1307/PdfPecker.Email</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Moonwalker1307</Copyright>
    <RepositoryUrl>https://github.com/Moonwalker1307/PdfPecker.Email</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- No baseline until the first release is on nuget.org; RELEASING.md says when to add it. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPecker" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="PdfPecker.Email.Tests" />
    <InternalsVisibleTo Include="PdfPecker.Email.Fuzz" />
    <InternalsVisibleTo Include="PdfPecker.Email.Benchmarks" />
  </ItemGroup>

</Project>
